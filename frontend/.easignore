# Use same ignores as git by default
.git/
.gitignore

# Node/expo locals
node_modules/
.expo/
.expo-shared/

# Android local/generated artifacts (critical for clean Linux cloud builds)
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/local.properties

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
