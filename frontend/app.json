{
  "expo": {
    "name": "frontend-expo",
    "slug": "frontend-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "frontend-expo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.blindly.telaia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5eb3d6aa-aa51-4cc3-a187-4984faec96e6"
      },
      "googleClientId": "983469817404-d7225crk182q0s7n3ut5n73jdjhvjf7u.apps.googleusercontent.com"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store"
    ],
    "owner": "towppy"
  }
}
